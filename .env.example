# ── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For local dev: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=output
MAX_FILE_SIZE_MB=200

# ── Cleanup ───────────────────────────────────────────────────────────────────
UPLOAD_RETENTION_DAYS=7
OUTPUT_RETENTION_DAYS=30

# ── ML Model thresholds ───────────────────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.35
QUALITY_MIN_SCORE=0.30
QUALITY_BLUR_THRESHOLD=300

# ── Job queue (optional — system works without Redis in sync mode) ────────────
# Install Redis: brew install redis (macOS) or sudo apt install redis-server
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
