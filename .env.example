# ── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=output
MODEL_CACHE_DIR=models
LOG_DIR=logs
MAX_FILE_SIZE_MB=200

# ── Cleanup ───────────────────────────────────────────────────────────────────
UPLOAD_RETENTION_DAYS=7
OUTPUT_RETENTION_DAYS=30

# ── ML Model thresholds ───────────────────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.35
QUALITY_MIN_SCORE=0.30
QUALITY_BLUR_THRESHOLD=300
FACE_SIZE_WEIGHT_THRESHOLD=0.05

# ── Redis + Celery (required for async mode) ──────────────────────────────────
# Install Redis:
#   macOS:  brew install redis && brew services start redis
#   Ubuntu: sudo apt install redis-server && sudo systemctl start redis
#
# Without Redis the system falls back to in-process APScheduler (dev/demo only).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery worker tuning
CELERY_WORKER_CONCURRENCY=1        # Keep at 1 — ML models are memory-heavy
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_TASK_TIME_LIMIT=600         # 10 min hard limit per task
CELERY_TASK_SOFT_TIME_LIMIT=540    # 9 min soft limit (raises SoftTimeLimitExceeded)

# ── Flower monitoring dashboard (optional) ────────────────────────────────────
FLOWER_PORT=5555
FLOWER_ENABLED=true
# FLOWER_USER=admin
# FLOWER_PASSWORD=admin

# ── GPU / device ──────────────────────────────────────────────────────────────
# DEVICE=cuda          # or cpu
# TORCH_DTYPE=float16  # or float32

# ── Error tracking (optional) ─────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
